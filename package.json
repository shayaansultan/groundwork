{
  "name": "groundwork",
  "private": true,
  "workspaces": [
    "apps/*",
    "modules/*"
  ],
  "type": "module",
  "scripts": {
    "setup": "bun install && bun scripts/setup.ts",
    "dev": "bun run --parallel --filter './apps/*' dev",
    "build": "bun run --filter './apps/*' build",
    "clean": "rm -rf apps/api/dist apps/web/dist coverage",
    "reset": "bun run clean && rm -rf node_modules && bun run setup",
    "typecheck": "bun run --filter './apps/*' --filter './modules/*' typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun run --filter './apps/*' --filter './modules/*' test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
